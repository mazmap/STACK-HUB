<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:STACK_HUB.ViewModels"
        xmlns:docking="clr-namespace:STACK_HUB.Docking.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:STACK_HUB.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="STACK_HUB.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="#26282C"
        Icon="/Assets/avalonia-logo.ico"
        Title="STACK HUB">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Toolbar / Menu Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#2D2D2D" Spacing="8">
            <TextBlock Text="Top-Bar"/>
        </StackPanel>

        <!-- Main Body Area with Sidebar and Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *">
            <!-- Left Sidebar -->
            <Border Grid.Column="0" Width="220" Background="#1E1E1E">
                <TextBlock Text="Sidebar Content" 
                           Foreground="#808080" 
                           Margin="12" 
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Workspace Area: Your Encapsulated Tiling Control -->
            <views:DockingWorkspace Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>