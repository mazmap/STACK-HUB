<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:STACK_HUB.ViewModels"
        xmlns:docking="clr-namespace:STACK_HUB.Docking.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:STACK_HUB.Views"
        xmlns:models="clr-namespace:STACK_HUB.Models"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="STACK_HUB.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="#2D2D2D"
        Icon="/Assets/avalonia-logo.ico"
        Title="STACK HUB">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Toolbar / Menu Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#2D2D2D" Spacing="8">
            <TextBlock Text="Top-Bar"/>
        </StackPanel>

        <!-- Main Body Area with Sidebar and Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="200" />
                <ColumnDefinition Width="4" MinWidth="4" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            
            <!-- Left Sidebar -->
           <ScrollViewer Grid.Column="0" Background="#191A1C" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" Spacing="8">
              <!-- Category 1: Settings -->
              <StackPanel>
                <TextBlock Text="Question settings"/>
                <Button Content="General settings"/>
                <Button Content="Maxima settings"/>
              </StackPanel>

              <!-- Category 2: Main Content -->
              <StackPanel>
                <TextBlock Text="Main content"/>
                <Button Content="Question variables"/>
                <Button Content="Question text"/>
              </StackPanel>

              <!-- Category 3: Input Settings list -->
              <StackPanel>
                <TextBlock Text="Input settings"/>
                <ItemsControl ItemsSource="{Binding ActiveQuestion.Inputs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:StackInput">
                      <Button Content="{Binding Name}" Classes="tree-item"  CommandParameter="{Binding Id}" Margin="8,0,0,0"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Category 4: Feedback options -->
              <StackPanel>
                <TextBlock Text="Feedback" Classes="sidebar-header"/>
                <Button Content="Specific Feedback" Classes="tree-item"  CommandParameter="specific_feedback"/>
                <Button Content="General Feedback" Classes="tree-item"  CommandParameter="general_feedback"/>
              </StackPanel>

              <!-- Category 5: Grading list -->
              <StackPanel>
                <TextBlock Text="Grading (PRTs)" Classes="sidebar-header"/>
                <ItemsControl ItemsSource="{Binding ActiveQuestion.Prts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:StackPrt">
                      <Button Content="{Binding Name}" Classes="tree-item"  CommandParameter="{Binding Id}" Margin="8,0,0,0"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          
          <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

            <!-- Workspace Area: Your Encapsulated Tiling Control -->
            <views:DockingWorkspace Grid.Column="2"/>
        </Grid>
    </Grid>
</Window>