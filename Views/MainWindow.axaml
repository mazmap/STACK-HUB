<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:STACK_HUB.ViewModels"
        xmlns:docking="clr-namespace:STACK_HUB.Docking.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:STACK_HUB.Views"
        xmlns:models="clr-namespace:STACK_HUB.Models"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="STACK_HUB.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="RootWindow"
        Background="#2D2D2D"
        Icon="/Assets/avalonia-logo.ico"
        Title="STACK HUB">

  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="Open Question..." Click="OnNativeOpenQuestionMenuClicked" Gesture="Cmd+O"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Exit" Click="OnNativeExitMenuClicked" Gesture="Cmd+Q"/>
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Window.KeyBindings>
    <KeyBinding Gesture="Cmd+O" Command="{Binding OpenQuestionFileCommand}"/>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenQuestionFileCommand}"/>
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.tree-item">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.tree-item:pointerover">
      <Setter Property="Background" Value="#1E1F2B"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.sidebar-add-btn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.sidebar-add-btn:pointerover">
      <Setter Property="Background" Value="#2A2D3A"/>
    </Style>
    <Style Selector="Button.sidebar-add-btn:pressed">
      <Setter Property="Background" Value="#383D4F"/>
    </Style>
    <Style Selector="Button.sidebar-add-btn PathIcon">
      <Setter Property="Foreground" Value="#94A3B8"/>
    </Style>
    <Style Selector="Button.sidebar-add-btn:pointerover PathIcon">
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.dialog-primary-btn">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.dialog-primary-btn:pointerover">
      <Setter Property="Background" Value="#3B82F6"/>
    </Style>
    <Style Selector="Button.dialog-primary-btn:pressed">
      <Setter Property="Background" Value="#1D4ED8"/>
    </Style>

    <Style Selector="Button.dialog-secondary-btn">
      <Setter Property="Background" Value="#2D3039"/>
      <Setter Property="Foreground" Value="#D1D5DB"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.dialog-secondary-btn:pointerover">
      <Setter Property="Background" Value="#3B3F4B"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.dialog-secondary-btn:pressed">
      <Setter Property="Background" Value="#25272E"/>
    </Style>

    <Style Selector="Button.dialog-close-btn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9CA3AF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.dialog-close-btn:pointerover">
      <Setter Property="Background" Value="#3B3F4B"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto, *">
        <!-- Top Application Menu Bar (visible on Windows/Linux or non-macOS platforms) -->
        <Border x:Name="InWindowMenuBar" Grid.Row="0" Background="#1E1E22" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="4,2">
            <Menu Background="Transparent">
                <MenuItem Header="_File" Foreground="#CCCCCC" FontSize="12">
                    <MenuItem Header="_Open Question..." 
                              Click="OnOpenQuestionMenuClicked"
                              Command="{Binding OpenQuestionFileCommand}" 
                              InputGesture="Ctrl+O"
                              Foreground="#CCCCCC"/>
                    <Separator Background="#333333"/>
                    <MenuItem Header="_Exit" 
                              Click="OnExitMenuClicked"
                              Command="{Binding CloseApplicationCommand}" 
                              InputGesture="Alt+F4"
                              Foreground="#CCCCCC"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- Main Body Area with Sidebar and Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="200" />
                <ColumnDefinition Width="4" MinWidth="4" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            
            <!-- Left Sidebar -->
           <ScrollViewer Grid.Column="0" Background="#191A1C" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" Spacing="8">
              <!-- Category 1: Settings -->
              <StackPanel>
                <TextBlock Text="Question settings"/>
                <Button Content="General settings" Classes="tree-item" Command="{Binding OpenGeneralSettingsCommand}"/>
                <Button Content="Maxima settings" Classes="tree-item" Command="{Binding OpenMaximaSettingsCommand}"/>
                <Button Content="Feedback settings" Classes="tree-item" Command="{Binding OpenFeedbackSettingsCommand}"/>
              </StackPanel>

              <!-- Category 2: Main Content -->
              <StackPanel>
                <TextBlock Text="Main content"/>
                <Button Content="Question variables" Classes="tree-item" Command="{Binding OpenQuestionVariablesCommand}"/>
                <Button Content="Question text" Classes="tree-item" Command="{Binding OpenQuestionTextCommand}"/>
              </StackPanel>

              <!-- Category 3: Input Settings list -->
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*, Auto">
                  <TextBlock Grid.Column="0" Text="Input settings" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" 
                          Classes="sidebar-add-btn" 
                          Command="{Binding OpenAddInputDialogCommand}" 
                          ToolTip.Tip="Add new input">
                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12"/>
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding ActiveQuestion.Inputs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:StackInput">
                      <Button Content="{Binding Name}" 
                              Classes="tree-item"  
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectInputCommand}"
                              CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Category 4: Feedback options -->
              <StackPanel>
                <TextBlock Text="Feedback" Classes="sidebar-header"/>
                <Button Content="Specific Feedback" Classes="tree-item" Command="{Binding OpenSpecificFeedbackCommand}"/>
                <Button Content="General Feedback" Classes="tree-item" Command="{Binding OpenGeneralFeedbackCommand}"/>
              </StackPanel>

              <!-- Category 5: Grading list -->
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*, Auto">
                  <TextBlock Grid.Column="0" Text="Grading (PRTs)" Classes="sidebar-header" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" 
                          Classes="sidebar-add-btn" 
                          Command="{Binding OpenAddPrtDialogCommand}" 
                          ToolTip.Tip="Add new PRT">
                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12"/>
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding ActiveQuestion.Prts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:StackPrt">
                      <Button Content="{Binding Name}" 
                              Classes="tree-item"  
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectPrtCommand}"
                              CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          
          <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

          <!-- Workspace Area: Your Encapsulated Tiling Control -->
          <views:DockingWorkspace Grid.Column="2" DataContext="{Binding Workspace}"/>
        </Grid>
        
        <!-- Modal Dialog Overlay for Adding Input / PRT -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Background="#75000000"
              IsVisible="{Binding IsAddDialogOpen}"
              PointerPressed="OnDialogBackdropPointerPressed">
            <Border Background="#1E2028"
                    BorderBrush="#3B3F4F"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="0 16 48 0 #70000000"
                    Padding="22"
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    PointerPressed="OnDialogCardPointerPressed">
                <StackPanel Spacing="16">
                    <!-- Title Bar -->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding AddDialogTitle}" 
                                   FontSize="15" 
                                   FontWeight="SemiBold" 
                                   Foreground="#FFFFFF" 
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" 
                                Content="✕" 
                                Command="{Binding CancelAddDialogCommand}"
                                Classes="dialog-close-btn"
                                ToolTip.Tip="Close"/>
                    </Grid>

                    <!-- Input Section -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding AddDialogPrompt}" 
                                   FontSize="12" 
                                   Foreground="#94A3B8"/>
                        <TextBox x:Name="AddDialogNameTextBox"
                                 Text="{Binding AddDialogName, Mode=TwoWay}"
                                 PlaceholderText="Enter name..."
                                 Background="#131418"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#3D4252"
                                 BorderThickness="1"
                                 CornerRadius="5"
                                 Padding="10,8"
                                 FontSize="13">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding ConfirmAddDialogCommand}"/>
                                <KeyBinding Gesture="Escape" Command="{Binding CancelAddDialogCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <TextBlock Text="{Binding AddDialogErrorMessage}"
                                   Foreground="#EF4444"
                                   FontSize="11"
                                   IsVisible="{Binding AddDialogErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Spacing="8">
                        <Button Content="Cancel" 
                                Command="{Binding CancelAddDialogCommand}"
                                Classes="dialog-secondary-btn"/>
                        <Button Content="Add" 
                                Command="{Binding ConfirmAddDialogCommand}"
                                Classes="dialog-primary-btn"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Canvas Width="0" Height="0" IsHitTestVisible="False">
          <views:CasTextEditor x:Name="PrewarmCasTextEditor" Width="800" Height="600" Canvas.Left="-9999" Canvas.Top="-9999" />
          <views:MaximaEditor x:Name="PrewarmMaximaEditor" Width="800" Height="600" Canvas.Left="-9999" Canvas.Top="-9999" />
          <views:PrtEditorView x:Name="PrewarmPrtEditorView" Width="800" Height="600" Canvas.Left="-9999" Canvas.Top="-9999" />
          <views:InputEditorView x:Name="PrewarmInputEditorView" Width="800" Height="600" Canvas.Left="-9999" Canvas.Top="-9999" />
          <views:GeneralSettingsView x:Name="PrewarmGeneralSettingsView" Width="800" Height="600" Canvas.Left="-9999" Canvas.Top="-9999" />
          <views:MaximaSettingsView x:Name="PrewarmMaximaSettingsView" Width="800" Height="600" Canvas.Left="-9999" Canvas.Top="-9999" />
          <views:FeedbackSettingsView x:Name="PrewarmFeedbackSettingsView" Width="800" Height="600" Canvas.Left="-9999" Canvas.Top="-9999" />
        </Canvas>
    </Grid>
</Window>