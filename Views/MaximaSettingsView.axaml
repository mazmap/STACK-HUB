<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:STACK_HUB.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="STACK_HUB.Views.MaximaSettingsView"
             x:DataType="vm:MaximaSettingsViewModel"
             Background="#18191D">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#8A8E9B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#23252B"/>
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="BorderBrush" Value="#353742"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, 'Courier New', monospace"/>
            <Setter Property="MaxWidth" Value="750"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#4B68A8"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#23252B"/>
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="BorderBrush" Value="#353742"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, 'Courier New', monospace"/>
            <Setter Property="MaxWidth" Value="750"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="#4B68A8"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, 'Courier New', monospace"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="MaxWidth" Value="750"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="16,16,16,40" MaxWidth="750" HorizontalAlignment="Left">
            
            <!-- 1. Question Simplify / Autosimplify -->
            <CheckBox IsChecked="{Binding Question.QuestionSimplify, Mode=TwoWay}" 
                      Content="Autosimplify / Vereinfachen aktivieren (question_simplify)"/>

            <!-- 2. Assume Positive -->
            <CheckBox IsChecked="{Binding Question.AssumePositive, Mode=TwoWay}" 
                      Content="Positive Variablen annehmen (assume_pos)"/>

            <!-- 3. Assume Real -->
            <CheckBox IsChecked="{Binding Question.AssumeReal, Mode=TwoWay}" 
                      Content="Reelle Variablen annehmen (assume_real)"/>

            <!-- 4. Sqrt Sign -->
            <CheckBox IsChecked="{Binding Question.SqrtSign, Mode=TwoWay}" 
                      Content="Wurzelzeichen anzeigen (sqrtdispflag)"/>

            <!-- 5. Decimals -->
            <StackPanel Spacing="0">
                <TextBlock Text="Dezimaltrennzeichen (decimals)" Classes="label"/>
                <ComboBox ItemsSource="{x:Static vm:MaximaSettingsViewModel.DecimalChoices}"
                          SelectedValue="{Binding Question.Decimals, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value}"
                          DisplayMemberBinding="{Binding Label}"/>
            </StackPanel>

            <!-- 6. Scientific Notation -->
            <StackPanel Spacing="0">
                <TextBlock Text="Wissenschaftliche Notation (scientific_notation)" Classes="label"/>
                <TextBox Text="{Binding Question.ScientificNotation, Mode=TwoWay}" PlaceholderText="z.B. 10E"/>
            </StackPanel>

            <!-- 7. Multiplication Sign -->
            <StackPanel Spacing="0">
                <TextBlock Text="Multiplikationszeichen (multiplicationsign)" Classes="label"/>
                <ComboBox ItemsSource="{x:Static vm:MaximaSettingsViewModel.MultiplicationSignChoices}"
                          SelectedValue="{Binding Question.MultiplicationSign, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value}"
                          DisplayMemberBinding="{Binding Label}"/>
            </StackPanel>

            <!-- 8. Complex Number -->
            <StackPanel Spacing="0">
                <TextBlock Text="Imaginäre Einheit (complexno)" Classes="label"/>
                <ComboBox ItemsSource="{x:Static vm:MaximaSettingsViewModel.ComplexNoChoices}"
                          SelectedValue="{Binding Question.ComplexNo, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value}"
                          DisplayMemberBinding="{Binding Label}"/>
            </StackPanel>

            <!-- 9. Inverse Trig Functions -->
            <StackPanel Spacing="0">
                <TextBlock Text="Inverse trigonometrische Funktionen (inversetrig)" Classes="label"/>
                <ComboBox ItemsSource="{x:Static vm:MaximaSettingsViewModel.InverseTrigChoices}"
                          SelectedValue="{Binding Question.InverseTrig, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value}"
                          DisplayMemberBinding="{Binding Label}"/>
            </StackPanel>

            <!-- 10. Logic Symbols -->
            <StackPanel Spacing="0">
                <TextBlock Text="Logische Symbole (logicsymbol)" Classes="label"/>
                <ComboBox ItemsSource="{x:Static vm:MaximaSettingsViewModel.LogicSymbolChoices}"
                          SelectedValue="{Binding Question.LogicSymbol, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value}"
                          DisplayMemberBinding="{Binding Label}"/>
            </StackPanel>

            <!-- 11. Matrix Parentheses -->
            <StackPanel Spacing="0">
                <TextBlock Text="Matrix-Klammern (matrixparens)" Classes="label"/>
                <ComboBox ItemsSource="{x:Static vm:MaximaSettingsViewModel.MatrixParensChoices}"
                          SelectedValue="{Binding Question.MatrixParens, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value}"
                          DisplayMemberBinding="{Binding Label}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
