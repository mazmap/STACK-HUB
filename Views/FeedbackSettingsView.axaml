<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:STACK_HUB.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="STACK_HUB.Views.FeedbackSettingsView"
             x:DataType="vm:FeedbackSettingsViewModel"
             Background="#18191D">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#8A8E9B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#23252B"/>
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="BorderBrush" Value="#353742"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, 'Courier New', monospace"/>
            <Setter Property="MaxWidth" Value="750"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#4B68A8"/>
        </Style>

        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="#23252B"/>
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="BorderBrush" Value="#353742"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="Background" Value="#2C2F37"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="16,16,16,40" MaxWidth="750" HorizontalAlignment="Left">
            
            <!-- 1. Standard Feedback für richtige Antworten -->
            <StackPanel Spacing="0">
                <TextBlock Text="Standard Feedback für richtige Antworten" Classes="label"/>
                <Border Height="110" BorderBrush="#353742" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                    <ContentControl Content="{Binding CorrectFeedbackEditor}"/>
                </Border>
            </StackPanel>

            <!-- 2. Standard Feedback für teilweise richtige Antworten -->
            <StackPanel Spacing="0">
                <TextBlock Text="Standard Feedback für teilweise richtige Antworten" Classes="label"/>
                <Border Height="110" BorderBrush="#353742" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                    <ContentControl Content="{Binding PartiallyCorrectFeedbackEditor}"/>
                </Border>
            </StackPanel>

            <!-- 3. Standard Feedback für falsche Antworten -->
            <StackPanel Spacing="0">
                <TextBlock Text="Standard Feedback für falsche Antworten" Classes="label"/>
                <Border Height="110" BorderBrush="#353742" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                    <ContentControl Content="{Binding IncorrectFeedbackEditor}"/>
                </Border>
            </StackPanel>

            <!-- 4. Hinweise (Hints) -->
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="Hinweise (Hints)" Classes="label" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" 
                            Content="+ Hinweis hinzufügen" 
                            Command="{Binding AddHintCommand}" 
                            Classes="action-btn"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding HintEditors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HintItemViewModel">
                            <StackPanel Spacing="4" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Index, StringFormat='Hinweis {0}'}" 
                                               Classes="label" 
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" 
                                            Content="Löschen" 
                                            Command="{Binding $parent[UserControl].((vm:FeedbackSettingsViewModel)DataContext).RemoveHintCommand}"
                                            CommandParameter="{Binding}"
                                            Foreground="#F92672" 
                                            Background="Transparent" 
                                            FontSize="11" 
                                            Padding="4,2"/>
                                </Grid>
                                <Border Height="90" BorderBrush="#353742" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                                    <ContentControl Content="{Binding Editor}"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
