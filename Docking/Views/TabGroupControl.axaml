<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:STACK_HUB.Docking.Models"
             xmlns:vm="clr-namespace:STACK_HUB.ViewModels"
             xmlns:templates="clr-namespace:STACK_HUB.Docking.Templates"
             x:Class="STACK_HUB.Docking.Views.TabGroupControl"
             x:DataType="models:TabGroupNode">
    <UserControl.Resources>
        <templates:LayoutTemplateSelector x:Key="LayoutSelector" />
    </UserControl.Resources>
    
    <UserControl.Styles>
    <!-- 1. Custom TabItem Control Template (Strips out default theme selection pipe) -->
    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,5" />
        <Setter Property="BorderBrush" Value="#808080" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="#252526" />
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- 2. Active State Styling (Blue Border) -->
    <Style Selector="TabItem:selected">
        <Setter Property="BorderBrush" Value="#007ACC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- 3. Pointer Hover State (Optional) -->
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#2A2D2E" />
    </Style>
</UserControl.Styles>

    <TabControl ItemsSource="{Binding Panes}"
                SelectedItem="{Binding ActivePane, Mode=TwoWay}">
        <!-- Tab Header Template -->
        <TabControl.ItemTemplate>
            <DataTemplate DataType="models:PaneNode">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" 
                            Background="Transparent"
                            PointerPressed="OnTabPointerPressed"
                            PointerMoved="OnTabPointerMoved"
                            PointerReleased="OnTabPointerReleased">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Padding="4, 0, 0, 0"/>

                    <!-- Close Button -->
                    <Button Content="✕"
                            Padding="4,1"
                            FontSize="10"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseCommand}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <!-- Tab Content Template -->
        <TabControl.ContentTemplate>
            <DataTemplate DataType="models:PaneNode">
                <!-- Explicitly assign ContentTemplate to trigger template resolution -->
                <ContentControl Content="{Binding ContentViewModel}" 
                                ContentTemplate="{StaticResource LayoutSelector}" />
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>